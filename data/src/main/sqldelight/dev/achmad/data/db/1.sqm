-- Bodies are kept now, so a parser installed later re-reads stored mail
-- instead of buying it from Gmail again; and a transaction records the source's
-- own kind, so the user can switch individual kinds off.
--
-- Both are added empty. An email fetched before this has no body and is still
-- re-read over the network the once, which backfills it.
ALTER TABLE email ADD COLUMN body_html TEXT;

ALTER TABLE transactions ADD COLUMN kind TEXT;

-- TRANSFER is no longer a type the app knows, and a row still holding it would
-- read back as no type at all: shown as unknown, and left out of the totals.
--
-- EXPENSE, because that is what it already behaved as — a transfer counted
-- against the balance exactly like an expense did, so this changes what the row
-- says and not what it means. The kind stays null; a re-parse fills it in with
-- whatever the extension now calls it.
UPDATE transactions SET type = 'EXPENSE' WHERE type = 'TRANSFER';
