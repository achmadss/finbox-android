CREATE TABLE transactions (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL,
    -- The extension's id, e.g. `bri` — see Extensions.all. Short again now
    -- that an extension is not a package; renaming one costs a reimport.
    -- Stored directly rather than hashed into an integer: the package is
    -- already unique and already stable across releases, so the hash bought
    -- nothing and cost a dump, a backup and the report tool their readability.
    extension_id TEXT NOT NULL,
    email_message_id TEXT NOT NULL,
    -- Gmail's conversation id, carried for export and debugging only: a thread
    -- can hold unrelated mail, so it says nothing about whether two rows are
    -- the same, and nothing queries it.
    thread_id TEXT,
    reference TEXT,
    date INTEGER,
    amount INTEGER,
    currency TEXT,
    direction TEXT,
    category TEXT,
    -- Who decided the category: USER or AI. Null when nobody did — a row not
    -- classified yet, or one code folded to UNKNOWN because its signature had
    -- nothing in it to classify with. That null is what lets UNKNOWN be
    -- re-evaluated later without a fourth state.
    category_source TEXT,
    description TEXT,
    merchant TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    -- When the user last hand-edited any field. Null means never.
    --
    -- Separate from updated_at on purpose: a re-parse stamps that one too, so
    -- it cannot tell a hand-edit from a machine write. A timestamp rather than
    -- a flag costs the same and lets the detail screen say when.
    edited_at INTEGER,
    deleted INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_transaction_email ON transactions(account_id, email_message_id);
CREATE INDEX idx_transaction_reference ON transactions(account_id, extension_id, reference);

SELECTAll:
SELECT * FROM transactions WHERE deleted = 0 ORDER BY COALESCE(date, created_at) DESC;

SELECTEverything:
SELECT * FROM transactions;

SELECTById:
SELECT * FROM transactions WHERE id = :id;

-- The duplicate check: the same provider reference from the same extension is
-- the same transaction, whichever message reported it.
SELECTByReference:
SELECT * FROM transactions
WHERE account_id = :accountId AND extension_id = :extensionId AND reference = :reference
LIMIT 1;

SELECTSearch:
SELECT * FROM transactions
WHERE deleted = 0
  AND (description LIKE '%' || :query || '%' OR merchant LIKE '%' || :query || '%' OR category LIKE '%' || :query || '%')
ORDER BY COALESCE(date, created_at) DESC;

-- Every row carrying a category worth reusing, for the signature cache. UNKNOWN
-- is excluded because it says the opposite: there was nothing to classify with.
SELECTCategorized:
SELECT * FROM transactions
WHERE deleted = 0 AND category IS NOT NULL AND category != 'UNKNOWN';

-- Ids derive from the Gmail message, so re-reading one overwrites instead of
-- duplicating.
INSERTOrReplace:
INSERT OR REPLACE INTO transactions(id, account_id, extension_id, email_message_id, thread_id, reference, date, amount, currency, direction, category, category_source, description, merchant, created_at, updated_at, edited_at, deleted)
VALUES (:id, :account_id, :extension_id, :email_message_id, :thread_id, :reference, :date, :amount, :currency, :direction, :category, :category_source, :description, :merchant, :created_at, :updated_at, :edited_at, :deleted);

UPDATEParsedById:
UPDATE transactions SET
    extension_id = :extension_id,
    email_message_id = :email_message_id,
    thread_id = :thread_id,
    reference = :reference,
    date = :date,
    amount = :amount,
    currency = :currency,
    direction = :direction,
    description = :description,
    merchant = :merchant,
    updated_at = :updated_at
WHERE id = :id;

-- The hand-edit path. Stamps edited_at, which is what puts the marker on the
-- row and what makes a later re-parse leave it alone.
UPDATEById:
UPDATE transactions SET
    reference = :reference,
    date = :date,
    amount = :amount,
    currency = :currency,
    direction = :direction,
    category = :category,
    category_source = :category_source,
    description = :description,
    merchant = :merchant,
    updated_at = :updated_at,
    edited_at = :edited_at
WHERE id = :id;

-- Setting a category by hand, one row or a whole selection. Counts as an edit:
-- the user decided this, and a re-parse must not undo it.
UPDATECategoryByUser:
UPDATE transactions SET
    category = :category,
    category_source = 'USER',
    updated_at = :updated_at,
    edited_at = :updated_at
WHERE id = :id;

-- The classify pass writing its own answer. Deliberately leaves edited_at
-- alone: the marker means the user edited the transaction, which stays true
-- even when a run replaces the category.
UPDATECategoryById:
UPDATE transactions SET
    category = :category,
    category_source = :category_source,
    updated_at = :updated_at
WHERE id = :id;

DELETEById:
UPDATE transactions SET deleted = 1, updated_at = :updated_at WHERE id = :id;

DELETEAllTransactions:
DELETE FROM transactions;
