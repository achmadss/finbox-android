CREATE TABLE transactions (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL,
    source_id INTEGER NOT NULL,
    -- Gmail's message id of the email this was parsed from.
    email_message_id TEXT NOT NULL,
    reference TEXT,
    date INTEGER,
    amount INTEGER,
    currency TEXT,
    type TEXT,
    category TEXT,
    description TEXT,
    merchant TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_transaction_email ON transactions(account_id, email_message_id);

SELECTAll:
SELECT * FROM transactions WHERE deleted = 0 ORDER BY COALESCE(date, created_at) DESC;

SELECTEverything:
SELECT * FROM transactions;

SELECTById:
SELECT * FROM transactions WHERE id = :id;

SELECTSearch:
SELECT * FROM transactions
WHERE deleted = 0
  AND (description LIKE '%' || :query || '%' OR merchant LIKE '%' || :query || '%' OR category LIKE '%' || :query || '%')
ORDER BY COALESCE(date, created_at) DESC;

-- Ids derive from the email and parser they came from, so re-parsing the same
-- email overwrites instead of duplicating.
INSERTOrReplace:
INSERT OR REPLACE INTO transactions(id, account_id, source_id, email_message_id, reference, date, amount, currency, type, category, description, merchant, created_at, updated_at, deleted)
VALUES (:id, :account_id, :source_id, :email_message_id, :reference, :date, :amount, :currency, :type, :category, :description, :merchant, :created_at, :updated_at, :deleted);

UPDATEById:
UPDATE transactions SET
    date = :date,
    amount = :amount,
    currency = :currency,
    type = :type,
    category = :category,
    description = :description,
    merchant = :merchant,
    updated_at = :updated_at
WHERE id = :id;

DELETEById:
UPDATE transactions SET deleted = 1, updated_at = :updated_at WHERE id = :id;

DELETEAllTransactions:
DELETE FROM transactions;
