CREATE TABLE transactions (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL,
    source_id INTEGER NOT NULL,
    parser_id INTEGER NOT NULL,
    email_message_id TEXT NOT NULL,
    reference TEXT,
    date INTEGER,
    amount INTEGER,
    currency TEXT,
    type TEXT,
    category TEXT,
    description TEXT,
    merchant TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

CREATE UNIQUE INDEX idx_transaction_dedup_ref
    ON transactions(account_id, source_id, reference)
    WHERE reference IS NOT NULL AND deleted = 0;

CREATE UNIQUE INDEX idx_transaction_dedup_email
    ON transactions(account_id, source_id, email_message_id)
    WHERE deleted = 0;

SELECTAll:
SELECT * FROM transactions WHERE deleted = 0 ORDER BY COALESCE(date, created_at) DESC;

SELECTById:
SELECT * FROM transactions WHERE id = :id;

SELECTSearch:
SELECT * FROM transactions
WHERE deleted = 0
  AND (description LIKE '%' || :query || '%' OR merchant LIKE '%' || :query || '%' OR category LIKE '%' || :query || '%')
ORDER BY COALESCE(date, created_at) DESC;

INSERTOrIgnore:
INSERT OR IGNORE INTO transactions(id, account_id, source_id, parser_id, email_message_id, reference, date, amount, currency, type, category, description, merchant, created_at, updated_at, deleted)
VALUES (:id, :account_id, :source_id, :parser_id, :email_message_id, :reference, :date, :amount, :currency, :type, :category, :description, :merchant, :created_at, :updated_at, :deleted);

UPDATEById:
UPDATE transactions SET
    date = :date,
    amount = :amount,
    currency = :currency,
    type = :type,
    category = :category,
    description = :description,
    merchant = :merchant,
    updated_at = :updated_at
WHERE id = :id;

DELETEById:
UPDATE transactions SET deleted = 1, updated_at = :updated_at WHERE id = :id;
