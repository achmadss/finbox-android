CREATE TABLE transactions (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL,
    parser_id INTEGER NOT NULL,
    email_message_id TEXT NOT NULL,
    -- Gmail's conversation id, carried for export and debugging only: a thread
    -- can hold unrelated mail, so it says nothing about whether two rows are
    -- the same, and nothing queries it.
    thread_id TEXT,
    reference TEXT,
    date INTEGER,
    amount INTEGER,
    currency TEXT,
    direction TEXT,
    -- The key of one of the parser's declared types, e.g. QRIS. The user
    -- switches these on and off, so a row has to say which it was parsed under.
    type TEXT,
    category TEXT,
    description TEXT,
    merchant TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_transaction_email ON transactions(account_id, email_message_id);
CREATE INDEX idx_transaction_reference ON transactions(account_id, parser_id, reference);

SELECTAll:
SELECT * FROM transactions WHERE deleted = 0 ORDER BY COALESCE(date, created_at) DESC;

SELECTEverything:
SELECT * FROM transactions;

SELECTById:
SELECT * FROM transactions WHERE id = :id;

-- The duplicate check: the same provider reference from the same parser is
-- the same transaction, whichever message reported it.
SELECTByReference:
SELECT * FROM transactions
WHERE account_id = :accountId AND parser_id = :parserId AND reference = :reference
LIMIT 1;

SELECTSearch:
SELECT * FROM transactions
WHERE deleted = 0
  AND (description LIKE '%' || :query || '%' OR merchant LIKE '%' || :query || '%' OR category LIKE '%' || :query || '%')
ORDER BY COALESCE(date, created_at) DESC;

-- Ids derive from the Gmail message, so re-reading one overwrites instead of
-- duplicating.
INSERTOrReplace:
INSERT OR REPLACE INTO transactions(id, account_id, parser_id, email_message_id, thread_id, reference, date, amount, currency, direction, type, category, description, merchant, created_at, updated_at, deleted)
VALUES (:id, :account_id, :parser_id, :email_message_id, :thread_id, :reference, :date, :amount, :currency, :direction, :type, :category, :description, :merchant, :created_at, :updated_at, :deleted);

UPDATEParsedById:
UPDATE transactions SET
    parser_id = :parser_id,
    email_message_id = :email_message_id,
    thread_id = :thread_id,
    reference = :reference,
    date = :date,
    amount = :amount,
    currency = :currency,
    direction = :direction,
    type = :type,
    description = :description,
    merchant = :merchant,
    updated_at = :updated_at
WHERE id = :id;

UPDATEById:
UPDATE transactions SET
    reference = :reference,
    date = :date,
    amount = :amount,
    currency = :currency,
    direction = :direction,
    type = :type,
    category = :category,
    description = :description,
    merchant = :merchant,
    updated_at = :updated_at
WHERE id = :id;

-- Hard delete: with the type off a re-parse would not write these back, so a
-- soft-deleted row would sit there forever. Switching it on re-parses.
DELETEByType:
DELETE FROM transactions WHERE parser_id = :parser_id AND type = :type;

DELETEById:
UPDATE transactions SET deleted = 1, updated_at = :updated_at WHERE id = :id;

DELETEAllTransactions:
DELETE FROM transactions;
