-- What a classify pass did, kept so the user can see where their money and
-- their tokens went. One row per run, written when it starts and updated as it
-- goes, so a run killed mid-flight still leaves a record saying so.
CREATE TABLE classification_run (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    started_at INTEGER NOT NULL,
    -- Null while it is still going.
    finished_at INTEGER,
    -- UNCATEGORIZED, SELECTION or ALL, and whether it was allowed to overwrite
    -- categories the user set by hand.
    scope TEXT NOT NULL,
    replace_manual INTEGER NOT NULL DEFAULT 0,
    -- Copied rather than referenced: a run is a record of what happened, and
    -- renaming a provider afterwards must not rewrite its history.
    provider_name TEXT,
    model TEXT,
    -- Signatures, not transactions: the unit the classifier actually works in.
    signatures_total INTEGER NOT NULL DEFAULT 0,
    signatures_sent INTEGER NOT NULL DEFAULT 0,
    signatures_cached INTEGER NOT NULL DEFAULT 0,
    -- Transactions written. Unknown is counted apart because it is an answer,
    -- not a failure, and a run that produced mostly unknowns is worth seeing.
    categorized INTEGER NOT NULL DEFAULT 0,
    unknown INTEGER NOT NULL DEFAULT 0,
    requests INTEGER NOT NULL DEFAULT 0,
    -- Null where the endpoint reports no usage, which many do not.
    prompt_tokens INTEGER,
    completion_tokens INTEGER,
    -- RUNNING, DONE, FAILED or CANCELLED.
    status TEXT NOT NULL,
    error TEXT
);

CREATE INDEX idx_classification_run_started ON classification_run(started_at);

SELECTRuns:
SELECT * FROM classification_run ORDER BY started_at DESC LIMIT :limit;

SELECTRunById:
SELECT * FROM classification_run WHERE id = :id;

INSERTRun:
INSERT INTO classification_run(started_at, scope, replace_manual, provider_name, model, signatures_total, status)
VALUES (:started_at, :scope, :replace_manual, :provider_name, :model, :signatures_total, 'RUNNING');

lastRunId:
SELECT last_insert_rowid();

-- Counters climb as batches land, so a run that dies keeps what it finished.
UPDATERunProgress:
UPDATE classification_run SET
    signatures_sent = signatures_sent + :signatures_sent,
    signatures_cached = signatures_cached + :signatures_cached,
    categorized = categorized + :categorized,
    unknown = unknown + :unknown,
    requests = requests + :requests,
    prompt_tokens = COALESCE(prompt_tokens, 0) + :prompt_tokens,
    completion_tokens = COALESCE(completion_tokens, 0) + :completion_tokens
WHERE id = :id;

UPDATERunFinished:
UPDATE classification_run SET finished_at = :finished_at, status = :status, error = :error
WHERE id = :id;

-- A run still marked RUNNING at startup was killed with the process; nothing
-- is going to finish it, and leaving it spinning in the history is a lie.
UPDATEStaleRuns:
UPDATE classification_run SET status = 'CANCELLED', finished_at = :finished_at
WHERE status = 'RUNNING';

DELETEAllRuns:
DELETE FROM classification_run;
