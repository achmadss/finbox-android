CREATE TABLE account_extension (
    account_id TEXT NOT NULL,
    source_id INTEGER NOT NULL,
    enabled INTEGER NOT NULL DEFAULT 1,
    position INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (account_id, source_id)
);

SELECTForAccount:
SELECT * FROM account_extension WHERE account_id = :accountId ORDER BY position;

SELECTForAccountAndSource:
SELECT * FROM account_extension WHERE account_id = :accountId AND source_id = :sourceId;

SELECTAll:
SELECT * FROM account_extension ORDER BY position;

INSERTOrReplace:
INSERT OR REPLACE INTO account_extension(account_id, source_id, enabled, position)
VALUES (:accountId, :sourceId, :enabled, :position);

DELETEForAccount:
DELETE FROM account_extension WHERE account_id = :accountId;

SETEnabled:
UPDATE account_extension SET enabled = :enabled WHERE account_id = :accountId AND source_id = :sourceId;

DELETEAllAssignments:
DELETE FROM account_extension;
