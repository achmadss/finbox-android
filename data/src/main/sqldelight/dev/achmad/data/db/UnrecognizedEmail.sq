CREATE TABLE unrecognized_email (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL,
    email_message_id TEXT NOT NULL,
    subject TEXT,
    sender TEXT,
    received_at INTEGER,
    reason TEXT,
    status TEXT NOT NULL DEFAULT 'UNREVIEWED',
    body_ref TEXT,
    created_at INTEGER NOT NULL,
    UNIQUE (account_id, email_message_id)
);

SELECTAll:
SELECT * FROM unrecognized_email ORDER BY received_at DESC;

SELECTById:
SELECT * FROM unrecognized_email WHERE id = :id;

INSERTOrIgnore:
INSERT OR IGNORE INTO unrecognized_email(id, account_id, email_message_id, subject, sender, received_at, reason, status, body_ref, created_at)
VALUES (:id, :account_id, :email_message_id, :subject, :sender, :received_at, :reason, :status, :body_ref, :created_at);

MARKReviewed:
UPDATE unrecognized_email SET status = 'REVIEWED' WHERE id = :id;

DELETEById:
DELETE FROM unrecognized_email WHERE id = :id;
